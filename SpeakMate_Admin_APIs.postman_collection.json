{
	"info": {
		"name": "SpeakMate Admin APIs",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Admin Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if(jsonData && jsonData.data && jsonData.data.jwtToken) {",
							"    pm.collectionVariables.set(\"admin_token\", jsonData.data.jwtToken);",
							"    console.log(\"Token automatically saved!\");",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"admin@speakmate.ai\",\n    \"password\": \"Admin@123\"\n}"
				},
				"url": {
					"raw": "http://localhost:9091/api/admin/auth/login",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "9091",
					"path": [
						"api",
						"admin",
						"auth",
						"login"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Admin Change Password",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{admin_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"oldPassword\": \"Admin@123\",\n    \"newPassword\": \"NewAdmin@123\"\n}"
				},
				"url": {
					"raw": "http://localhost:9091/api/admin/auth/change-password",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "9091",
					"path": [
						"api",
						"admin",
						"auth",
						"change-password"
					]
				}
			},
			"response": []
		},
		{
			"name": "3. Admin Forgot Password (Request OTP)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"admin@speakmate.ai\"\n}"
				},
				"url": {
					"raw": "http://localhost:9091/api/admin/auth/forgot-password",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "9091",
					"path": [
						"api",
						"admin",
						"auth",
						"forgot-password"
					]
				}
			},
			"response": []
		},
		{
			"name": "4. Admin Verify OTP",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if(jsonData && jsonData.data && jsonData.data.token) {",
							"    pm.collectionVariables.set(\"reset_token\", jsonData.data.token);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"admin@speakmate.ai\",\n    \"otp\": \"123456\"\n}"
				},
				"url": {
					"raw": "http://localhost:9091/api/admin/auth/verify-otp",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "9091",
					"path": [
						"api",
						"admin",
						"auth",
						"verify-otp"
					]
				}
			},
			"response": []
		},
		{
			"name": "5. Admin Reset Password",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"token\": \"{{reset_token}}\",\n    \"newPassword\": \"NewAdmin@123\"\n}"
				},
				"url": {
					"raw": "http://localhost:9091/api/admin/auth/reset-password",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "9091",
					"path": [
						"api",
						"admin",
						"auth",
						"reset-password"
					]
				}
			},
			"response": []
		},
		{
			"name": "6. Admin Refresh Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if(jsonData && jsonData.data && jsonData.data.jwtToken) {",
							"    pm.collectionVariables.set(\"admin_token\", jsonData.data.jwtToken);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"refreshToken\": \"{{admin_token}}\"\n}"
				},
				"url": {
					"raw": "http://localhost:9091/api/admin/auth/refresh-token",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "9091",
					"path": [
						"api",
						"admin",
						"auth",
						"refresh-token"
					]
				}
			},
			"response": []
		},
		{
			"name": "7. Admin Logout",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{admin_token}}"
					}
				],
				"url": {
					"raw": "http://localhost:9091/api/admin/auth/logout",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "9091",
					"path": [
						"api",
						"admin",
						"auth",
						"logout"
					]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "admin_token",
			"value": ""
		},
		{
			"key": "reset_token",
			"value": ""
		}
	]
}
